       <widget class="QGroupBox" name="groupBox_pictureLevels">
        <property name="title">
         <string>Picture levels</string>
        </property>
        <property name="toolTip">
         <string>Cut what a dim LED or LCD display shows for the segments that are off (ghosting), and stretch the lit segments back to full white. Applies to the whole picture: the preview, Binary View and the OCR.</string>
        </property>
        <layout class="QFormLayout" name="formLayout_pictureLevels">
         <item row="0" column="0" colspan="2">
          <widget class="QCheckBox" name="checkBox_pictureLevels">
           <property name="toolTip">
            <string>Apply a black point, a white point and a gamma to every frame. Off by default.</string>
           </property>
           <property name="text">
            <string>Apply black point and white point</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="label_blackPoint">
           <property name="text">
            <string>Black point</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QSpinBox" name="spinBox_blackPoint">
           <property name="toolTip">
            <string>Every gray level up to this one becomes black. Raise it past the level the display shows for segments that are off (the ghosting), and below the lit segments.</string>
           </property>
           <property name="maximum">
            <number>254</number>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="label_whitePoint">
           <property name="text">
