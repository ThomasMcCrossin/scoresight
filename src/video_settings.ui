           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QSpinBox" name="spinBox_whitePoint">
           <property name="toolTip">
            <string>Every gray level from this one up becomes white. Keep it at or below the brightest lit segments.</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>255</number>
           </property>
           <property name="value">
