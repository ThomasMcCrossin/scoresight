         </item>
         <item row="3" column="1">
          <widget class="QDoubleSpinBox" name="doubleSpinBox_gamma">
           <property name="toolTip">
            <string>Brightens (above 1) or darkens (below 1) the midtones after the levels. 1.00 leaves them as they are.</string>
